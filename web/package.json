{
  "name": "zhk-3d-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:furniture": "esbuild scripts/check-furniture.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --log-level=warning | node --input-type=module -"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
