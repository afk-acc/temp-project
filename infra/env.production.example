# Переменные бэкенда на сервере: /home/projects/spliti/infra/.env.app (создаёт deploy.sh --init, в git/rsync не идёт)
APP_NAME=Spliti
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://spliti.uz
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=spliti.uz,www.spliti.uz

CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
